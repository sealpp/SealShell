{
  "name": "seal-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080 --host 127.0.0.1",
    "dev:lan": "vite --port 18080 --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "preview:lan": "vite preview --port 18080 --host 0.0.0.0",
    "gen:proto": "uv run --directory ../node --locked --extra dev python scripts/generate_proto.py --typescript-only",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@tabler/icons-vue": "3.45.0",
    "@tanstack/vue-table": "9.3.1",
    "@tanstack/vue-virtual": "3.13.48",
    "@verdigris/libssh2.js": "file:../vendor/libssh2.js",
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockview-vue": "^7.0.4",
    "monaco-editor": "0.57.0",
    "reka-ui": "2.10.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.2.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0"
  }
}
